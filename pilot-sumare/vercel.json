{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/conta/confirmar",
      "destination": "/conta.html"
    },
    {
      "source": "/conta/recuperar",
      "destination": "/conta.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.pwnedpasswords.com; worker-src 'self' blob:; frame-src 'self'; font-src 'self'; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/((?!$|index\\.html$|blog\\.html$|instalar\\.html$|robots\\.txt$|sitemap\\.xml$|og-image\\.png$|logo-header\\.webp$|logo-web\\.webp$|favicon\\.ico$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!.*\\.(?:js|mjs|css|webmanifest|png|webp|svg|ico|wasm|gz|pfb|ttf|txt)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|css|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|svg|ico|wasm|gz|pfb|ttf|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/laboratorio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/laboratorio/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/plataforma.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/editorial.mjs": {
      "maxDuration": 240
    },
    "api/subscriptions.mjs": {
      "maxDuration": 240
    },
    "api/ai.mjs": {
      "maxDuration": 240
    }
  },
  "crons": [
    {
      "path": "/api/editorial?action=scheduled",
      "schedule": "0 11 * * *"
    }
  ]
}
